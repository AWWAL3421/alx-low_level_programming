#!/bin/bash
#include <stdio.h>
#include <main.h>

int _putchar(char c){
    return putchar(c);
}

int _islower(int c){
    return c >= 'a' && c <= 'z';
}

int _isalpha(int c){
    return _islower(c) || _isupper(c);
}

int _abs(int n){
    return n < 0 ? -n : n;
}

int _isupper(int c){
    return c >= 'A' && c <= 'Z';
}

int _isdigit(int c){
    return c >= '0' && c <= '9';
}

int _strlen(char *s){
    int len = 0;
    while (*s++){
        len++;
    }
    return len;
}

void _puts(char *s){
    while (*s){
        _putchar(*s++);
    }
    _putchar('\n');
}

char *_strcpy(char *dest, char *src){
    char *d = dest;
    while (*src){
        *dest++ = *src++;
    }
    *dest = '\0';
    return d;
}

int _atoi(char *s){
    int n = 0, sign = 1;
    if (*s == '-'){
        sign = -1;
        s++;
    }
    while (_isdigit(*s)){
        n = n * 10 + (*s - '0');
        s++;
    }
    return sign * n;
}

char *_strcat(char *dest, char *src){
    char *d = dest;
    while (*dest){
        dest++;
    }
    while (*src){
        *dest++ = *src++;
    }
    *dest = '\0';
    return d;
}

char *_strncat(char *dest, char *src, int n){
    char *d = dest;
    while (*dest){
        dest++;
    }
    while (*src && n--){
        *dest++ = *src++;
    }
    *dest = '\0';
    return d;
}

char *_strncpy(char *dest, char *src, int n){
    char *d = dest;
    while (*src && n--){
        *dest++ = *src++;
    }
    while (n--){
        *dest++ = '\0';
    }
    return d;
}

int _strcmp(char *s1, char *s2){
    while (*s1 && (*s1 == *s2)){
        s1++;
        s2++;
    }
    return *(unsigned char*)s1 - *(unsigned char*)s2;
}

char *_memset(char *s, char b, unsigned int n){
    char *d = s;
    while (n--){
        *s++ = b;
    }
    return d;
}

char *_memcpy(char *dest, char *src, unsigned int n){
    char *d = dest;
    while (n--){
        *dest++ = *src++;
    }
    return d;
}

char *_strchr(char *s, char c){
    while (*s && *s != c){
        s++;
    }
    return *s == c ? s : NULL;
}

unsigned int _strspn(char *s, char *accept){
    unsigned int n = 0;
    char *p;
    while (*s){
        p = accept;
        while (*p && *p != *s){
            p++;
        }
        if (*p){
            n++;
            s++;
        }
        else{
            break;
        }
    }
    return n;
}

char *_strpbrk(char *s, char *accept){
    while (*s){
        char *p = accept;
        while (*p){
            if (*p == *s){
                return s;
            }
            p++;
        }
        s++;
    }
    return NULL;
}

char *_strstr(char *haystack, char *needle){
    while (*haystack){
        char *p = haystack;
        char *q = needle;
        while (*q && *p == *q){
            p++;
            q++;
        }
        if (*q == '\0'){
            return haystack;
        }
        haystack++;
    }
    return NULL;
}

